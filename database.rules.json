{
  "rules": {
    "devices": {
      "$deviceId": {
        ".read": "auth != null && (auth.uid === data.child('owner').val() || auth.uid === data.child('deviceUid').val())",
        ".write": "auth != null && (auth.uid === root.child('devices').child($deviceId).child('owner').val() || auth.uid === root.child('devices').child($deviceId).child('deviceUid').val())",
        "owner": {
          ".validate": "newData.isString()"
        },
        "deviceUid": {
          ".validate": "newData.isString()"
        },
        "config": {
          ".validate": "newData.hasChildren(['schedule'])",
          "schedule": {
            ".validate": "newData.hasChildren()"
          },
          "tzOffsetMin": {
            ".validate": "newData.isNumber() && newData.val() >= -720 && newData.val() <= 840"
          },
          "pillsLeft": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "pillsCountedUntil": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "pillsBase": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "pillsBaseFrom": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "defaultDose": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10"
          },
          "doseWeek": {
            ".validate": "newData.hasChildren(['0','1','2','3','4','5','6'])",
            "$dzienTygodnia": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
            }
          },
          "doseDays": {
            "$data": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
            }
          },
          "wifiNowa": {
            ".validate": "newData.hasChildren(['ssid'])",
            "ssid": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32"
            },
            "pass": {
              ".validate": "newData.isString() && newData.val().length <= 63"
            },
            "ts": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            }
          },
          "wifiCmd": {
            ".validate": "newData.hasChildren(['akcja','ssid'])",
            "akcja": {
              ".validate": "newData.isString() && (newData.val() === 'usun' || newData.val() === 'priorytet')"
            },
            "ssid": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32"
            },
            "ts": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            }
          },
          "otaCmd": {
            ".validate": "newData.hasChildren(['md5'])",
            "md5": {
              ".validate": "newData.isString() && newData.val().length === 32"
            },
            "wersja": {
              ".validate": "newData.isString() && newData.val().length <= 15"
            },
            "ts": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "$other": {
              ".validate": false
            }
          },
          "wifiScan": {
            ".validate": "newData.hasChildren(['ts'])",
            "ts": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "$other": {
              ".validate": false
            }
          },
          "tgNowy": {
            ".validate": "newData.hasChildren(['token','chat'])",
            "token": {
              ".validate": "newData.isString() && newData.val().length > 20 && newData.val().length <= 64"
            },
            "chat": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
            },
            "ts": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "$other": {
              ".validate": false
            }
          },
          "tgCmd": {
            ".validate": "newData.hasChildren(['akcja'])",
            "akcja": {
              ".validate": "newData.isString() && (newData.val() === 'usun' || newData.val() === 'test')"
            },
            "ts": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "$other": {
              ".validate": false
            }
          },
          "drugName": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "drugStrength": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "inrMin": {
            ".validate": "newData.isNumber() && newData.val() >= 0.5 && newData.val() <= 10"
          },
          "inrMax": {
            ".validate": "newData.isNumber() && newData.val() >= 0.5 && newData.val() <= 12"
          },
          "$other": {
            ".validate": true
          },
          "tz": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "trackingSince": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          }
        },
        "status": {
          "battery": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "tg": {
            ".validate": "newData.isBoolean()"
          },
          "tgMsg": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "volt": {
            ".validate": "newData.isNumber()"
          },
          "lastSeen": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": true
          }
        },
        "scan": {
          ".validate": "newData.hasChildren(['ts'])",
          "ts": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "nets": {
            "$i": {
              ".validate": "newData.hasChildren(['s','r'])",
              "s": {
                ".validate": "newData.isString() && newData.val().length <= 32"
              },
              "r": {
                ".validate": "newData.isNumber() && newData.val() >= -120 && newData.val() <= 0"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "events": {
          ".indexOn": [
            "ts"
          ],
          "$eventId": {
            ".validate": "newData.hasChildren(['ts','type'])",
            "ts": {
              ".validate": "newData.isNumber()"
            },
            "type": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "battery": {
              ".validate": "newData.isNumber()"
            },
            "volt": {
              ".validate": "newData.isNumber()"
            },
            "slot": {
              ".validate": "newData.isNumber()"
            },
            "fw": {
              ".validate": "newData.isString()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "nvsfaillog": {
          "$paczkaId": {
            ".validate": "newData.hasChildren(['wpisy'])",
            "wpisy": {
              "$i": {
                ".validate": "newData.hasChildren(['ts','klucz'])",
                "ts": {
                  ".validate": "newData.isNumber() && newData.val() >= 0"
                },
                "klucz": {
                  ".validate": "newData.isString() && newData.val().length <= 12"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "doses": {
          "$date": {
            "$slot": {
              ".validate": "newData.hasChildren(['status'])",
              "status": {
                ".validate": "newData.val() === 'taken' || newData.val() === 'missed' || newData.val() === 'skipped'"
              },
              "dose": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
              },
              "source": {
                ".validate": "newData.val() === 'device' || newData.val() === 'manual'"
              },
              "ts": {
                ".validate": "newData.isNumber()"
              },
              "openTs": {
                ".validate": "newData.isNumber()"
              },
              "note": {
                ".validate": "newData.isString() && newData.val().length <= 300"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "inr": {
          "$date": {
            ".validate": "newData.hasChildren(['value'])",
            "value": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 15"
            },
            "ts": {
              ".validate": "newData.isNumber()"
            },
            "note": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "dosePlans": {
          "$od": {
            ".validate": "newData.hasChildren(['dd'])",
            "dd": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
            },
            "dw": {
              "$i": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
              }
            },
            "ts": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    ".read": false,
    ".write": false
  }
}
